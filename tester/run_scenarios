#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TESTRUNNER_BIN="${SCRIPT_DIR}/testrunner"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'

# Build testrunner executable if missing
if [ ! -f "$TESTRUNNER_BIN" ]; then
    make -C "$SCRIPT_DIR" || exit 1
fi

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-6667}"
SERVER_PID=""

# Optional isolated server lifecycle. Existing users can continue to start the
# server themselves; when SERVER_BIN is set it receives PORT, PASSWORD, and
# shell-word-split SERVER_EXTRA_ARGS in that order.
if [ -n "${SERVER_BIN:-}" ]; then
    read -r -a EXTRA_ARGS <<< "${SERVER_EXTRA_ARGS:-}"
    "$SERVER_BIN" "$PORT" "${PASSWORD:-}" "${EXTRA_ARGS[@]}" &
    SERVER_PID=$!
    trap 'if [ -n "$SERVER_PID" ]; then kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true; fi' EXIT INT TERM
    sleep "${SERVER_START_DELAY:-0.5}"
fi
SCENARIOS_DIR="${SCRIPT_DIR}/scenarios"

SPECS=()

add_spec_by_num() {
    local num_str="$1"
    # Format single digit to 2 digits (e.g. 1 -> 01)
    if [[ "$num_str" =~ ^[0-9]+$ ]]; then
        local formatted
        formatted=$(printf "%02d" "$num_str" 2>/dev/null || echo "$num_str")
        while IFS= read -r f; do
            if [ -f "$f" ]; then
                if [[ ! " ${SPECS[*]} " =~ " ${f} " ]]; then
                    SPECS+=("$f")
                    return 0
                fi
            fi
        done < <(find "$SCENARIOS_DIR" -type f -name "${formatted}*.spec" -o -type f -name "${num_str}*.spec" | sort)
    fi
    return 1
}

VERBOSE="${VERBOSE:-0}"
RAW_ARGS=()

for arg in "$@"; do
    if [ "$arg" = "--v" ] || [ "$arg" = "-v" ] || [ "$arg" = "--verbose" ]; then
        VERBOSE=1
    else
        RAW_ARGS+=("$arg")
    fi
done

if [ ${#RAW_ARGS[@]} -eq 0 ]; then
    # Without args: run all specs
    while IFS= read -r f; do
        if [ -f "$f" ]; then
            SPECS+=("$f")
        fi
    done < <(find "$SCENARIOS_DIR" -type f -name '*.spec' | sort)
else
    # Process specified numbers / arguments
    for arg in "${RAW_ARGS[@]}"; do
        if ! add_spec_by_num "$arg"; then
            # If argument like '13' didn't match a scenario 13, split digits (e.g. '1' and '3')
            if [[ "$arg" =~ ^[0-9]+$ ]] && [ ${#arg} -gt 1 ]; then
                for (( i=0; i<${#arg}; i++ )); do
                    digit="${arg:$i:1}"
                    add_spec_by_num "$digit"
                done
            else
                # Fallback: substring / filename glob search
                for f in "$SCENARIOS_DIR"/*"$arg"*.spec; do
                    if [ -f "$f" ]; then
                        if [[ ! " ${SPECS[*]} " =~ " ${f} " ]]; then
                            SPECS+=("$f")
                        fi
                    fi
                done
            fi
        fi
    done
fi

if [ ${#SPECS[@]} -eq 0 ]; then
    echo "No matching test spec files found to execute."
    exit 1
fi

format_folder_title() {
    local dir="$1"
    if [ "$dir" = "." ] || [ -z "$dir" ]; then
        echo "Scenarios"
        return
    fi
    local result=""
    IFS='/' read -ra PARTS <<< "$dir"
    for part in "${PARTS[@]}"; do
        local with_spaces="${part//_/ }"
        with_spaces="${with_spaces//-/ }"
        local part_title=""
        for word in $with_spaces; do
            local cap
            cap="$(printf '%s' "${word:0:1}" | tr '[:lower:]' '[:upper:]')${word:1}"
            if [ -z "$part_title" ]; then
                part_title="$cap"
            else
                part_title="$part_title $cap"
            fi
        done
        if [ -z "$result" ]; then
            result="$part_title"
        else
            result="$result / $part_title"
        fi
    done
    echo "$result"
}

format_test_name() {
    local base="$1"
    local with_spaces="${base//_/ }"
    with_spaces="${with_spaces//-/ }"
    local title=""
    for word in $with_spaces; do
        local cap
        cap="$(printf '%s' "${word:0:1}" | tr '[:lower:]' '[:upper:]')${word:1}"
        if [ -z "$title" ]; then
            title="$cap"
        else
            title="$title $cap"
        fi
    done
    echo "$title"
}

failed=0
total=0
current_dir=""

cd "$SCRIPT_DIR"

for spec in "${SPECS[@]}"; do
    total=$((total + 1))
    rel_spec="${spec#${SCENARIOS_DIR}/}"
    dir_name="$(dirname "$rel_spec")"
    spec_file="$(basename "$spec")"
    spec_base="${spec_file%.spec}"

    if [ "$dir_name" != "$current_dir" ]; then
        current_dir="$dir_name"
        folder_title=$(format_folder_title "$dir_name")
        if [ $total -gt 1 ]; then
            echo ""
        fi
        echo -e "${BOLD}== ${folder_title} ==${NC}"
    fi

    test_name=$(format_test_name "$spec_base")
    RUNNER_ARGS=(--host "$HOST" --port "$PORT")
    if [ "$VERBOSE" -eq 1 ]; then
        RUNNER_ARGS+=(--v)
    fi
    output=$("$TESTRUNNER_BIN" "${RUNNER_ARGS[@]}" "$spec" 2>&1)
    status=$?

    if [ "$VERBOSE" -eq 1 ]; then
        echo -e "${BOLD}--- [${spec_base}] ---${NC}"
        echo "$output"
        echo ""
    fi

    if [ $status -eq 0 ]; then
        echo -e "${GREEN}${test_name}   ✅${NC}"
    else
        failed=$((failed + 1))
        err_msg=$(echo "$output" | grep -E '^FAIL \[' | head -n 1 | sed -E 's/^FAIL \[[^]]*\] //')
        if [ -z "$err_msg" ]; then
            err_msg=$(echo "$output" | grep -v '^[[:space:]]*$' | head -n 1)
        fi
        if [ -n "$err_msg" ]; then
            echo -e "${RED}${test_name}   ❌   ${err_msg}${NC}"
        else
            echo -e "${RED}${test_name}   ❌${NC}"
        fi
        echo -e "   ${RED}\033[4mtester/logs/${spec_base}.log${NC}\n"
    fi
    sleep 0.05
done

echo ""
echo "----------------------------------------"
if [ $failed -eq 0 ]; then
    echo -e "${GREEN}Summary: $((total - failed))/$total scenarios passed.${NC}"
else
    echo -e "${RED}Summary: $((total - failed))/$total scenarios passed.${NC}"
fi

if [ $failed -gt 0 ]; then
    exit 1
fi
