# 251_QUIT_oversized_line_flood_overflow.spec
# Tests that an adversary sending an oversized line exceeding the 512-byte IRC message limit is disconnected.
CLIENTS C1

C1 SEND PASS 1234
C1 SEND NICK Alice
C1 SEND USER alice 0 * :Alice
C1 EXPECT 001 Alice :*

# Send 550 bytes line exceeding 512-byte limit
C1 SEND QUIT :
C1 EXPECT_DISCONNECT
